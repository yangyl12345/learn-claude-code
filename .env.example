# OpenAI API key（必填；请只放在本机 .env 或安全的环境变量中）
OPENAI_API_KEY=your_openai_api_key_here

# Responses API 使用的模型名（必填，不在代码中硬编码）
OPENAI_MODEL=your_model_name

# s17 的独立 evaluator 模型（可选；不设置时回退到 OPENAI_MODEL）
# OPENAI_EVALUATOR_MODEL=your_evaluator_model

# 可选：OpenAI-compatible 网关地址由 SDK 的环境变量支持决定。
# 不要把 Authorization header 或 API key 写入仓库。
